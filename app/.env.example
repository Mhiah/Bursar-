# Which Arc network the site and agent use: mainnet or testnet.
NEXT_PUBLIC_BURSAR_NETWORK=mainnet
# BursarFactory address on that network (from `npm run deploy:testnet` in ../contracts).
NEXT_PUBLIC_FACTORY_ADDRESS=0x7a165EAAe476BE36b5613F6fc022c03D0B3cefd5
# Public address of the agent key. Owners authorise this address on their vault.
NEXT_PUBLIC_AGENT_ADDRESS=
# Optional RPC override (defaults to the public Arc RPC).
ARC_RPC_URL=

# Public URL of the site, used in payment links sent to customers.
APP_URL=http://localhost:3000
# Long random string used to sign login cookies.
SESSION_SECRET=

# Postgres connection string. Leave empty to use a local database file in .data/.
DATABASE_URL=

# --- Agent worker only (never exposed to the browser) ---
ANTHROPIC_API_KEY=
# Private key of the agent address above. It can only act inside each vault's rules.
AGENT_PRIVATE_KEY=
# Seconds between agent runs.
AGENT_INTERVAL_SECONDS=120

# --- Wallet checks ---
# Free key from https://www.chainalysis.com/free-cryptocurrency-sanctions-screening-tools/
CHAINALYSIS_API_KEY=

# --- Chasing customers ---
RESEND_API_KEY=
EMAIL_FROM=Bursar <billing@example.com>
TELEGRAM_BOT_TOKEN=
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
