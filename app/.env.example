# Which Arc network the site and agent use: mainnet or testnet.
NEXT_PUBLIC_BURSAR_NETWORK=mainnet
# BursarFactory address on that network (from `npm run deploy:testnet` in ../contracts).
NEXT_PUBLIC_FACTORY_ADDRESS=0x13c95c918599b33Cbae7bb32d9C4920993E4713f
NEXT_PUBLIC_SAVINGS_FACTORY_ADDRESS=0x1EE09d0f5d435c38414B0e842A3f62a3842Efb70
# Public address of the agent's wallet. Owners authorise this address on their vault.
NEXT_PUBLIC_AGENT_ADDRESS=
# Optional RPC override (defaults to the public Arc RPC).
ARC_RPC_URL=

# Public URL of the site, used in payment links sent to customers.
APP_URL=http://localhost:3000
# Long random string used to sign login cookies.
SESSION_SECRET=

# Postgres connection string. Leave empty to use a local database file in .data/.
DATABASE_URL=

# --- Agent worker only (never exposed to the browser) ---
# Where the agent's AI comes from. "blockrun" pays for Claude per call in USDC on Arc
# from the Circle agent wallet (Circle Agent Marketplace, x402); no Anthropic account needed.
# Leave empty to use ANTHROPIC_API_KEY instead.
AI_PROVIDER=blockrun
# Cheaper model and shorter answers keep each paid call small.
AI_MODEL=claude-haiku-4-5
AI_MAX_TOKENS=3000
# Refuse any single AI call priced above this many USDC.
AI_MAX_USDC_PER_CALL=0.10
# The most the agent spends on AI in one day (timer runs and button presses together).
AI_MAX_USDC_PER_DAY=0.25
ANTHROPIC_API_KEY=
# How the agent signs: "circle" uses a Circle Agent Wallet through the Circle CLI
# (run `npx circle wallet login <email> --type agent` once in this folder; no key here).
# Leave empty to sign with AGENT_PRIVATE_KEY instead.
AGENT_SIGNER=circle
# Only when AGENT_SIGNER is empty: private key of the agent address above.
AGENT_PRIVATE_KEY=
# Seconds between agent runs.
AGENT_INTERVAL_SECONDS=120

# --- Wallet checks ---
# Optional. Without a key, wallets are checked against the US Treasury (OFAC) sanctions list, free.
CHAINALYSIS_API_KEY=

# --- Chasing customers ---
RESEND_API_KEY=
EMAIL_FROM=Bursar <billing@example.com>
TELEGRAM_BOT_TOKEN=
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
